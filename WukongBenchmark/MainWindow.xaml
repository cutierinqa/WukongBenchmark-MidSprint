<Window x:Class="WukongBenchmark.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wukong Benchmark Suite"
        Width="1200"
        Height="800"
        MinWidth="1000"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#111318">
    <Window.Resources>

        <Style x:Key="MenuButtonStyle"
       TargetType="Button">

            <Setter Property="Background"
            Value="#1B1F27"/>

            <Setter Property="Foreground"
            Value="#AEB4C2"/>

            <Setter Property="BorderThickness"
            Value="0"/>

            <Setter Property="FontSize"
            Value="14"/>

            <Setter Property="FontWeight"
            Value="SemiBold"/>

            <Setter Property="Cursor"
            Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                        Background="{TemplateBinding Background}"
                        CornerRadius="10"
                        Padding="12">

                            <ContentPresenter
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                             Value="True">

                                <Setter TargetName="ButtonBorder"
                                Property="Background"
                                Value="#29261F"/>

                                <Setter Property="Foreground"
                                Value="#D4A84F"/>

                                <Setter TargetName="ButtonBorder"
                                Property="Effect">

                                    <Setter.Value>

                                        <DropShadowEffect
                                    Color="#D4A84F"
                                    BlurRadius="18"
                                    ShadowDepth="0"
                                    Opacity="0.65"/>

                                    </Setter.Value>

                                </Setter>

                            </Trigger>

                            <Trigger Property="IsPressed"
                             Value="True">

                                <Setter TargetName="ButtonBorder"
                                Property="Background"
                                Value="#3A3020"/>

                                <Setter Property="Foreground"
                                Value="#E4BD69"/>

                                <Setter TargetName="ButtonBorder"
                                Property="Effect">

                                    <Setter.Value>

                                        <DropShadowEffect
                                    Color="#D4A84F"
                                    BlurRadius="12"
                                    ShadowDepth="0"
                                    Opacity="0.85"/>

                                    </Setter.Value>

                                </Setter>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                             Value="False">

                                <Setter TargetName="ButtonBorder"
                                Property="Opacity"
                                Value="0.5"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>
        <Style x:Key="ActiveMenuButtonStyle"
       TargetType="Button">
            <Setter Property="Background" Value="#29261F"/>
            <Setter Property="Foreground" Value="#D4A84F"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                        CornerRadius="10"
                        Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                Background="#D4A84F"
                                CornerRadius="2"/>

                                <ContentPresenter Grid.Column="1"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="8,0,0,0"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle"
       TargetType="Button">

            <Setter Property="Background"
            Value="#B88A2E"/>

            <Setter Property="Foreground"
            Value="White"/>

            <Setter Property="BorderThickness"
            Value="0"/>

            <Setter Property="FontSize"
            Value="14"/>

            <Setter Property="FontWeight"
            Value="Bold"/>

            <Setter Property="Cursor"
            Value="Hand"/>

            <Setter Property="RenderTransformOrigin"
            Value="0.5,0.5"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="PrimaryBorder"
                        Background="{TemplateBinding Background}"
                        CornerRadius="12"
                        Padding="14">

                            <ContentPresenter
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                             Value="True">

                                <Setter TargetName="PrimaryBorder"
                                Property="Background"
                                Value="#29261F"/>

                                <Setter Property="Foreground"
                                Value="#D4A84F"/>

                                <Setter TargetName="PrimaryBorder"
                                Property="Effect">

                                    <Setter.Value>

                                        <DropShadowEffect
                                    Color="#D4A84F"
                                    BlurRadius="20"
                                    ShadowDepth="0"
                                    Opacity="0.7"/>

                                    </Setter.Value>

                                </Setter>

                            </Trigger>

                            <Trigger Property="IsPressed"
                             Value="True">

                                <Setter TargetName="PrimaryBorder"
                                Property="Background"
                                Value="#3A3020"/>

                                <Setter Property="Foreground"
                                Value="#E4BD69"/>

                                <Setter TargetName="PrimaryBorder"
                                Property="Effect">

                                    <Setter.Value>

                                        <DropShadowEffect
                                    Color="#D4A84F"
                                    BlurRadius="14"
                                    ShadowDepth="0"
                                    Opacity="0.9"/>

                                    </Setter.Value>

                                </Setter>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                             Value="False">

                                <Setter TargetName="PrimaryBorder"
                                Property="Opacity"
                                Value="0.5"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#181B22"
                Padding="20">

            <StackPanel>

                <TextBlock Text="WUKONG"
                           Foreground="White"
                           FontSize="22"
                           FontWeight="Bold"/>

                <TextBlock Text="BENCHMARK SUITE"
                           Foreground="#8B92A3"
                           FontSize="11"
                           Margin="0,2,0,35"/>


                <Button x:Name="HomeButton"
                        Content="Главная"
                        Height="45"
                        Margin="0,0,0,10"
                        Style="{StaticResource ActiveMenuButtonStyle}"
                        Click="HomeButton_Click"/>

                <Button x:Name="HistoryButton"
                        Content="История"
                        Height="45"
                        Margin="0,0,0,10"
                        Style="{StaticResource MenuButtonStyle}"
                        Click="HistoryButton_Click"/>

            </StackPanel>

        </Border>

        <Grid Grid.Column="1">

            <ScrollViewer x:Name="HomeView"
                  VerticalScrollBarVisibility="Auto">

                <StackPanel Margin="35">

                    <TextBlock Text="Black Myth: Wukong"
                           Foreground="White"
                           FontSize="32"
                           FontWeight="Bold"/>
                    <Border Height="1"
                            Width="65"
                            Background="#D4A84F"
                            HorizontalAlignment="Left"
                            Margin="0,10,0,0"/>

                    <TextBlock Text="Автоматическое тестирование производительности ПК"
                           Foreground="#8B92A3"
                           FontSize="14"
                           Margin="0,8,0,30"/>

                    <TextBlock Text="СИСТЕМА"
                           Foreground="#8B92A3"
                           FontSize="12"
                           FontWeight="Bold"
                           Margin="0,0,0,10"/>


                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                            Background="#1B1F27"
                            CornerRadius="10"
                            Padding="20"
                            Margin="0,0,10,0">

                            <StackPanel>

                                <TextBlock Text="CPU"
                                       Foreground="#8B92A3"
                                       FontSize="12"/>

                                <TextBlock x:Name="CpuText"
                                       Text="Загрузка..."
                                       Foreground="White"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"/>

                            </StackPanel>

                        </Border>

                        <Border Grid.Column="1"
                            Background="#1B1F27"
                            CornerRadius="10"
                            Padding="20"
                            Margin="5,0">

                            <StackPanel>

                                <TextBlock Text="GPU"
                                       Foreground="#8B92A3"
                                       FontSize="12"/>

                                <TextBlock x:Name="GpuText"
                                       Text="Загрузка..."
                                       Foreground="White"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"/>

                            </StackPanel>

                        </Border>

                        <Border Grid.Column="2"
                            Background="#1B1F27"
                            CornerRadius="10"
                            Padding="20"
                            Margin="10,0,0,0">

                            <StackPanel>

                                <TextBlock Text="RAM"
                                       Foreground="#8B92A3"
                                       FontSize="12"/>

                                <TextBlock x:Name="RamText"
                                       Text="Загрузка..."
                                       Foreground="White"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Margin="0,8,0,0"/>

                            </StackPanel>

                        </Border>

                    </Grid>

                    <TextBlock Text="ТЕСТИРОВАНИЕ"
                           Foreground="#8B92A3"
                           FontSize="12"
                           FontWeight="Bold"
                           Margin="0,35,0,10"/>


                    <Border Background="#1B1F27"
                        CornerRadius="10"
                        Padding="25">

                        <StackPanel>

                            <TextBlock Text="Готово к тестированию"
                                   Foreground="White"
                                   FontSize="22"
                                   FontWeight="SemiBold"/>

                            <TextBlock Text="Приложение автоматически выполнит два benchmark-теста: CPU и GPU."
                                   Foreground="#8B92A3"
                                   FontSize="14"
                                   Margin="0,8,0,20"/>

                            <Button Content="ЗАПУСТИТЬ ПОЛНЫЙ ТЕСТ"
                                Width="250"
                                Height="52"
                                Style="{StaticResource PrimaryButtonStyle}"
                                HorizontalAlignment="Left"
                                FontWeight="Bold"
                                Click="RunFullBenchmarkButton_Click"/>


                        </StackPanel>

                    </Border>

                    <Grid Margin="0,35,0,10">

                        <TextBlock Text="РЕЗУЛЬТАТЫ"
               Foreground="#8B92A3"
               FontWeight="Bold"
               FontSize="12"
               VerticalAlignment="Center"/>

                        <StackPanel HorizontalAlignment="Right"
            Orientation="Horizontal">

                            <TextBlock x:Name="LastTestDateText"
               FontSize="14"
               Foreground="#888888"
               VerticalAlignment="Center"/>

                            <TextBlock x:Name="TestDurationText"
               Text=" · Время: —"
               FontSize="14"
               Foreground="#D4A84F"
               VerticalAlignment="Center"/>

                        </StackPanel>

                    </Grid>


                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                            Background="#1B1F27"
                            CornerRadius="10"
                            Padding="25"
                            Margin="0,0,10,0">

                            <StackPanel>

                                <TextBlock Text="CPU TEST"
                                       Foreground="#8B92A3"
                                       FontSize="13"
                                       FontWeight="Bold"/>


                                <TextBlock Text="Средний FPS"
                                       Foreground="#8B92A3"
                                       FontSize="12"
                                       Margin="0,20,0,0"/>

                                <TextBlock x:Name="CpuAverageFpsText"
                                       Text="— FPS"
                                       Foreground="White"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       Margin="0,3,0,15"/>


                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>


                                    <StackPanel Grid.Column="0">

                                        <TextBlock Text="Maximum"
                                               Foreground="#8B92A3"
                                               FontSize="11"/>

                                        <TextBlock x:Name="CpuMaximumFpsText"
                                               Text="— FPS"
                                               Foreground="White"
                                               FontSize="16"
                                               Margin="0,3,0,10"/>


                                        <TextBlock Text="Low 5th"
                                               Foreground="#8B92A3"
                                               FontSize="11"/>

                                        <TextBlock x:Name="CpuLow5thFpsText"
                                               Text="— FPS"
                                               Foreground="White"
                                               FontSize="16"
                                               Margin="0,3,0,0"/>

                                    </StackPanel>


                                    <StackPanel Grid.Column="1">

                                        <TextBlock Text="Minimum"
                                               Foreground="#8B92A3"
                                               FontSize="11"/>

                                        <TextBlock x:Name="CpuMinimumFpsText"
                                               Text="— FPS"
                                               Foreground="White"
                                               FontSize="16"
                                               Margin="0,3,0,10"/>


                                        <TextBlock Text="Used VRAM"
                                               Foreground="#8B92A3"
                                               FontSize="11"/>
                                        <TextBlock x:Name="CpuUsedVramText"
                                               Text="—"
                                               Foreground="White"
                                               FontSize="16"
                                               FontWeight="SemiBold"/>



                                    </StackPanel>

                                </Grid>


                                <Border Background="#15181E"
                                    CornerRadius="6"
                                    Padding="12"
                                    Margin="0,20,0,0">

                                    <StackPanel>

                                        <TextBlock Text="НАСТРОЙКИ"
                                               Foreground="#8B92A3"
                                               FontSize="10"
                                               FontWeight="Bold"/>

                                        <TextBlock x:Name="CpuSettingsText"
                                               Text="Low"
                                               Foreground="White"
                                               FontSize="13"
                                               Margin="0,5,0,0"/>

                                    </StackPanel>

                                </Border>

                            </StackPanel>

                        </Border>

                        <Border Grid.Column="1"
                            Background="#1B1F27"
                            CornerRadius="10"
                            Padding="25"
                            Margin="10,0,0,0">

                            <StackPanel>

                                <TextBlock Text="GPU TEST"
                                       Foreground="#8B92A3"
                                       FontSize="13"
                                       FontWeight="Bold"/>


                                <TextBlock Text="Средний FPS"
                                       Foreground="#8B92A3"
                                       FontSize="12"
                                       Margin="0,20,0,0"/>

                                <TextBlock x:Name="GpuAverageFpsText"
                                       Text="— FPS"
                                       Foreground="White"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       Margin="0,3,0,15"/>


                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>


                                    <StackPanel Grid.Column="0">

                                        <TextBlock Text="Maximum"
                                               Foreground="#8B92A3"
                                               FontSize="11"/>

                                        <TextBlock x:Name="GpuMaximumFpsText"
                                               Text="— FPS"
                                               Foreground="White"
                                               FontSize="16"
                                               Margin="0,3,0,10"/>


                                        <TextBlock Text="Low 5th"
                                               Foreground="#8B92A3"
                                               FontSize="11"/>

                                        <TextBlock x:Name="GpuLow5thFpsText"
                                               Text="— FPS"
                                               Foreground="White"
                                               FontSize="16"
                                               Margin="0,3,0,0"/>

                                    </StackPanel>


                                    <StackPanel Grid.Column="1">

                                        <TextBlock Text="Minimum"
                                               Foreground="#8B92A3"
                                               FontSize="11"/>

                                        <TextBlock x:Name="GpuMinimumFpsText"
                                               Text="— FPS"
                                               Foreground="White"
                                               FontSize="16"
                                               Margin="0,3,0,10"/>


                                        <TextBlock Text="Used VRAM"
                                               Foreground="#8B92A3"
                                               FontSize="11"/>
                                        <TextBlock x:Name="GpuUsedVramText"
                                               Text="—"
                                               Foreground="White"
                                               FontSize="16"
                                               FontWeight="SemiBold"/>

                                    </StackPanel>

                                </Grid>


                                <Border Background="#15181E"
                                    CornerRadius="6"
                                    Padding="12"
                                    Margin="0,20,0,0">

                                    <StackPanel>

                                        <TextBlock Text="НАСТРОЙКИ"
                                               Foreground="#8B92A3"
                                               FontSize="10"
                                               FontWeight="Bold"/>

                                        <TextBlock x:Name="GpuSettingsText"
                                               Text="Ultra + Ray Tracing"
                                               Foreground="White"
                                               FontSize="13"
                                               Margin="0,5,0,0"/>

                                    </StackPanel>

                                </Border>

                            </StackPanel>

                        </Border>

                    </Grid>

                    <TextBlock Text="ИНФОРМАЦИЯ О СИСТЕМЕ"
                           Foreground="#8B92A3"
                           FontSize="12"
                           FontWeight="Bold"
                           Margin="0,35,0,10"/>


                    <Border Background="#1B1F27"
                        CornerRadius="10"
                        Padding="20">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
               Grid.Column="0"
               Text="Game Version"
               Foreground="#8B92A3"
               Margin="0,0,0,10"/>

                            <TextBlock x:Name="GameVersionText"
               Grid.Row="0"
               Grid.Column="1"
               Text="—"
               Foreground="White"
               Margin="0,0,0,10"/>


                            <TextBlock Grid.Row="1"
               Grid.Column="0"
               Text="OS Version"
               Foreground="#8B92A3"
               Margin="0,0,0,10"/>

                            <TextBlock x:Name="OsVersionText"
               Grid.Row="1"
               Grid.Column="1"
               Text="—"
               Foreground="White"
               Margin="0,0,0,10"/>


                            <TextBlock Grid.Row="2"
               Grid.Column="0"
               Text="GPU Driver"
               Foreground="#8B92A3"
               Margin="0,0,0,10"/>

                            <TextBlock x:Name="GpuDriverText"
               Grid.Row="2"
               Grid.Column="1"
               Text="—"
               Foreground="White"
               Margin="0,0,0,10"/>


                            <TextBlock Grid.Row="3"
               Grid.Column="0"
               Text="VRAM"
               Foreground="#8B92A3"
               Margin="0,0,0,10"/>

                            <TextBlock x:Name="VramText"
               Grid.Row="3"
               Grid.Column="1"
               Text="—"
               Foreground="White"
               Margin="0,0,0,10"/>


                            <TextBlock Grid.Row="4"
               Grid.Column="0"
               Text="Frame Generation"
               Foreground="#8B92A3"/>

                            <TextBlock x:Name="FrameGenerationText"
                               Grid.Row="4"
                               Grid.Column="1"
                               Text="—"
                               Foreground="White"/>

                        </Grid>

                    </Border>


                </StackPanel>

            </ScrollViewer>

            <ScrollViewer x:Name="HistoryView"
                      Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto">

                <StackPanel Margin="35">

                    <TextBlock Text="История"
                           Foreground="White"
                           FontSize="32"
                           FontWeight="Bold"/>

                    <TextBlock Text="Результаты предыдущих тестов"
                           Foreground="#8B92A3"
                           FontSize="14"
                           Margin="0,5,0,30"/>

                    <StackPanel x:Name="HistoryPanel"/>

                </StackPanel>

            </ScrollViewer>

        </Grid>

        <Image x:Name="SplashLogo"
       Source="/WukongBenchmark;component/assets/wukong_logo.png"
       Width="650"
       Height="354"
       Stretch="Uniform"
       HorizontalAlignment="Center"
       VerticalAlignment="Center"
       Opacity="0"
       Panel.ZIndex="100"
       Grid.ColumnSpan="2"
       IsHitTestVisible="False"/>
    </Grid>

</Window>